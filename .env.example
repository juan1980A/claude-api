# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca subas API keys reales al repositorio.
#
# Importante: el código de las clases lee las variables con os.getenv() /
# process.env, pero NO carga el archivo .env automáticamente. Expórtalas en tu
# terminal antes de ejecutar los ejemplos:
#
#   set -a && source .env && set +a
#
# (o usa `export ANTHROPIC_API_KEY="..."` directamente)

# --- Requerido en todas las clases ---
# Tu API key de Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Opcional: solo clase 16 (frontend + hub con FastAPI / Fastify) ---
# Puerto del servidor web.
# Ruta TypeScript: el código lee PORT (por defecto 3000).
# Ruta Python: uvicorn no lee PORT, se pasa con `uvicorn --port 8000`.
PORT=3000
